-- Ayarlar
local LOOP_COUNT = 25
local LOOP_DELAY = 4 -- saniye
local BATCH_SIZE = 1000

-- Field numaralarını bir kez topla
local fieldNumbers = {}
for _, field in ipairs(cropFolder:GetChildren()) do
    local num = string.match(field.Name, "%d+%->(%d+)")
    if num then
        fieldNumbers[#fieldNumbers + 1] = tonumber(num)
    end
end

print("Toplam field bulundu:", #fieldNumbers)

-- Fonksiyon: tüm fieldleri tek seferde sulama
local function SprayAllFields()
    local count = #fieldNumbers
    local i = 1

    while i <= count do
        local batchFields = {}
        local batchTargets = {}

        for j = 0, BATCH_SIZE - 1 do
            local index = i + j
            if index <= count then
                batchFields[#batchFields + 1] = fieldNumbers[index]
                batchTargets[#batchTargets + 1] = targetSpray
            end
        end

        Event:InvokeServer(fieldObj, batchFields, batchTargets)
        i += BATCH_SIZE
    end
end

-- 25 tur döngü ile otomatik sulama
for loop = 1, LOOP_COUNT do
    SprayAllFields()
    print("Tur:", loop, "| Sulanan field:", #fieldNumbers)
    if loop < LOOP_COUNT then
        task.wait(LOOP_DELAY)
    end
end

