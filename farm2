-- Logları alma fonksiyonu
local function getAllLogs()
	local logs = {}
	for _, obj in ipairs(DraggableFolder:GetChildren()) do
		if obj.Name == "Log" and obj:IsA("Model") then
			table.insert(logs, obj)
		end
	end
	return logs
end

----------------------------------------------------
-- OTOMATİK DÖNGÜ (LOG BİTENE KADAR)
----------------------------------------------------

while true do

	local allLogs = getAllLogs()
	local totalLogs = #allLogs

	-- Log kalmadıysa dur
	if totalLogs == 0 then
		print("Tüm loglar işlendi. Sistem durdu.")
		break
	end

	local totalSawmills = #sawmills
	local baseAmount = math.floor(totalLogs / totalSawmills)
	local remainder = totalLogs % totalSawmills

	local logIndex = 1

	for _, sawmill in ipairs(sawmills) do

		local logsForSawmill = baseAmount
		if remainder > 0 then
			logsForSawmill += 1
			remainder -= 1
		end

		if logsForSawmill > 0 then

			local logsToSend = {}

			for j = 1, logsForSawmill do
				if allLogs[logIndex] then
					table.insert(logsToSend, allLogs[logIndex])
					logIndex += 1
				end
			end

			-- Logları hauler'a al
			task.spawn(function()
				EatEvent:FireServer(logsToSend)
			end)

			task.wait(0.001)

			-- Sawmill'e gönder
			task.spawn(function()
				DepositEvent:FireServer(Hauler, sawmill)
			end)

			print(#logsToSend .. " log " .. sawmill.Name .. "e gönderildi.")
		end
	end

	task.wait(0.1)

end


