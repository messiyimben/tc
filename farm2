-- DRIVE (PHYSICS BASED)
----------------------------------------------------
local challenger = challengerModel
local function driveTo(targetPos)

	VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.W, false, game)

	local connection
	connection = RunService.RenderStepped:Connect(function(dt)

		if not challenger.PrimaryPart then return end

		local pivot = challenger:GetPivot()
		local pos = pivot.Position

		local direction = (targetPos - pos)
		local distance = direction.Magnitude

		if distance < 2 then
			connection:Disconnect()
			VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.W, false, game)
			return
		end

		direction = direction.Unit

		-- araç yönünü hedefe kilitle
		local lookCFrame = CFrame.lookAt(pos, pos + direction)

		-- ileri hareket
		local move = direction * moveSpeed * dt

		challenger:PivotTo(lookCFrame + move)

	end)

	repeat task.wait() until (challenger:GetPivot().Position - targetPos).Magnitude < 2

end



