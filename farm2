local function runCycle(implement)
	for i, route in ipairs(routes) do
		teleport(challenger, route.start)
		if i == 1 then
			hitch(implement)
			task.wait(1)
		else
			teleport(implement, route.start)
		end
		task.wait(0.5)
		driveTo(route.target)
		task.wait(0.5)
	end
	unhitch()
	task.wait(1)
end

