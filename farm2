-- HITCH / UNHITCH
----------------------------------------------------
local function hitch(implement)
	if not challenger.PrimaryPart or not implement.PrimaryPart then return end
	local behindCFrame = challenger:GetPivot() * CFrame.new(0,0,implementDistanceBehind)
	implement:PivotTo(behindCFrame)
	task.wait(0.1)
	ReplicatedStorage.Modules.Larry.FNCAttemptHitch:InvokeServer(
		challenger.Components.Hitchable,
		implement.Chassis.HitchableSocket
	)
end

local function unhitch()
	ReplicatedStorage.Modules.Larry.FNCUnhitch:InvokeServer(challenger.Components.Hitchable)
end

